# 模型后端：dashscope | openai_compat
MODEL_BACKEND=dashscope

# DashScope（通义千问）
DASHSCOPE_API_KEY=sk-xxx
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7

# OpenAI 兼容后端（Ollama / vLLM / OpenAI）
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3

# 百炼知识库（三域 Index + 默认回退）
BAILIAN_ENABLE=false
BAILIAN_WORKSPACE_ID=
BAILIAN_INDEX_ID=
BAILIAN_INDEX_KNOWLEDGE_ID=
BAILIAN_INDEX_PRODUCT_ID=
BAILIAN_INDEX_REGULATORY_ID=

# 分层记忆
SESSION_DIR=./data/sessions
MAX_HISTORY_TURNS=10
WORKING_MEMORY_TURNS=6
MAX_EPISODIC_TURNS=50
EPISODIC_RECALL_COUNT=8
ENABLE_SUMMARY=true

# Checkpoint（sqlite | memory）
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DIR=./data/checkpoints

# 运行工件
RUNS_DIR=./data/runs

# 工具安全
TOOL_DUPLICATE_WINDOW_SECONDS=30

# MCP
MCP_ENABLE=false
MCP_SERVERS_FILE=./mcp-servers.json

# 服务
HOST=0.0.0.0
PORT=8123
API_PREFIX=/api
